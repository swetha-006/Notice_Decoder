# Notice Check - Environment Configuration

# Preferred AI provider: Groq (OpenAI-compatible API, free-tier availability varies)
# Create a key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Google AI Studio Gemini API Key (Free tier)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Primary Gemini model
GEMINI_MODEL=gemini-3.8-flash

# Optional comma-separated fallback models (used only when the primary is unavailable)
GEMINI_MODEL_FALLBACKS=
